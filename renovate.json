{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitsDisabled"
  ],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "matchManagers": ["gradle"],
      "groupName": "gradle dependencies"
    },
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true
    }
  ]
}
