<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <PreferenceCategory
    android:key="category_connection_defaults"
    android:title="@string/prefcat_connection_defaults">

    <EditTextPreference
      android:key="default_username"
      android:title="@string/prefs_default_username_title"
      android:summary="@string/prefs_default_username_summary"
      android:defaultValue="root"
      app:useSimpleSummaryProvider="true" />

    <EditTextPreference
      android:key="default_port"
      android:title="@string/prefs_default_port_title"
      android:summary="@string/prefs_default_port_summary"
      android:defaultValue="22"
      android:inputType="number"
      app:useSimpleSummaryProvider="true" />

    <EditTextPreference
      android:key="connect_timeout"
      android:title="@string/prefs_connect_timeout_title"
      android:summary="@string/prefs_connect_timeout_summary"
      android:defaultValue="15"
      android:inputType="number"
      app:useSimpleSummaryProvider="true" />

  </PreferenceCategory>

  <!-- Keep-alive is always on at the SSH layer (10s ServerAliveInterval,
       3 missed before disconnect — see SSHConnection.configureSession).
       The user-facing on/off toggle was removed to stop the appearance of a
       setting that does nothing on mobile; the interval remains adjustable. -->
  <PreferenceCategory
    android:key="category_connection_behavior"
    android:title="@string/prefcat_connection_session">

    <SwitchPreferenceCompat
      android:key="compression_enabled"
      android:title="@string/prefs_compression_enabled_title"
      android:summary="@string/prefs_compression_enabled_summary"
      android:defaultValue="true" />

    <SwitchPreferenceCompat
      android:key="auto_reconnect"
      android:title="@string/prefs_auto_reconnect_title"
      android:summary="@string/prefs_auto_reconnect_summary"
      android:defaultValue="false" />

    <EditTextPreference
      android:key="server_alive_interval"
      android:title="@string/prefs_server_alive_interval_title"
      android:summary="@string/prefs_server_alive_interval_summary"
      android:defaultValue="60"
      android:inputType="number"
      app:useSimpleSummaryProvider="true" />

  </PreferenceCategory>

  <PreferenceCategory
    android:key="category_connection_forwarding"
    android:title="@string/prefcat_connection_forwarding">

    <SwitchPreferenceCompat
      android:key="x11_forwarding_default"
      android:title="@string/prefs_x11_forwarding_default_title"
      android:summary="@string/prefs_x11_forwarding_default_summary"
      android:defaultValue="false" />

    <SwitchPreferenceCompat
      android:key="agent_forwarding_default"
      android:title="@string/prefs_agent_forwarding_default_title"
      android:summary="@string/prefs_agent_forwarding_default_summary"
      android:defaultValue="false" />

  </PreferenceCategory>

  <PreferenceCategory
    android:key="category_file_open"
    android:title="@string/prefcat_connection_files">

    <EditTextPreference
      android:key="file_open_size_limit_mb"
      android:title="@string/prefs_file_open_size_limit_mb_title"
      android:summary="@string/prefs_file_open_size_limit_mb_summary"
      android:defaultValue="20"
      android:inputType="number"
      app:useSimpleSummaryProvider="true" />

  </PreferenceCategory>

</PreferenceScreen>
