<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <!-- The application log has no on/off switch; this row explains why. -->
  <PreferenceCategory
    android:key="category_logging_app"
    android:title="@string/prefcat_logging_app"
    android:icon="@drawable/ic_logs">

    <Preference
      android:key="app_log_info"
      android:title="@string/prefs_app_log_info_title"
      android:summary="@string/prefs_app_log_info_summary"
      android:selectable="false" />

  </PreferenceCategory>

  <!-- Developer builds only — hidden at runtime in release by LoggingSettingsFragment. -->
  <PreferenceCategory
    android:key="debug_logging_category"
    android:title="@string/prefcat_logging_debug"
    android:icon="@drawable/ic_info">

    <SwitchPreferenceCompat
      android:key="debug_logging_enabled"
      android:title="@string/prefs_debug_logging_enabled_title"
      android:summary="@string/prefs_debug_logging_enabled_summary"
      android:defaultValue="false" />

    <ListPreference
      android:key="debug_log_level"
      android:title="@string/prefs_debug_log_level_title"
      android:summary="@string/prefs_debug_log_level_summary"
      android:entries="@array/log_levels"
      android:entryValues="@array/log_level_values"
      android:defaultValue="debug"
      android:dependency="debug_logging_enabled" />

    <SwitchPreferenceCompat
      android:key="log_keystroke_bytes"
      android:title="@string/prefs_log_keystroke_bytes_title"
      android:summary="@string/prefs_log_keystroke_bytes_summary"
      android:defaultValue="false"
      android:dependency="debug_logging_enabled" />

    <!-- Hidden at runtime when BuildConfig.DEBUG_LOG is false. -->
    <Preference
      android:key="test_crash"
      android:title="@string/prefs_test_crash_title"
      android:summary="@string/prefs_test_crash_summary"
      android:icon="@drawable/ic_error" />

  </PreferenceCategory>

  <PreferenceCategory
    android:key="category_logging_host"
    android:title="@string/prefcat_logging_host"
    android:icon="@drawable/ic_computer">

    <SwitchPreferenceCompat
      android:key="host_logging_enabled"
      android:title="@string/prefs_host_logging_enabled_title"
      android:summary="@string/prefs_host_logging_enabled_summary"
      android:defaultValue="false" />

    <Preference
      android:key="host_log_info"
      android:title="@string/prefs_host_log_info_title"
      android:summary="@string/prefs_host_log_info_summary"
      android:selectable="false"
      android:dependency="host_logging_enabled" />

    <SeekBarPreference
      android:key="host_log_max_size_mb"
      android:title="@string/prefs_host_log_max_size_mb_title"
      android:summary="@string/prefs_host_log_max_size_mb_summary"
      android:defaultValue="1"
      android:min="1"
      android:max="10"
      app:showSeekBarValue="true"
      android:dependency="host_logging_enabled" />

  </PreferenceCategory>

  <!-- Every log this app can produce, and where to read it, in one list. -->
  <PreferenceCategory
    android:key="category_logging_view"
    android:title="@string/prefcat_logging_view"
    android:icon="@drawable/ic_file_text">

    <Preference
      android:key="view_app_log"
      android:title="@string/prefs_view_app_log_title"
      android:summary="@string/prefs_view_app_log_summary"
      android:icon="@drawable/ic_logs" />

    <Preference
      android:key="view_debug_log"
      android:title="@string/prefs_view_debug_log_title"
      android:summary="@string/prefs_view_debug_log_summary"
      android:icon="@drawable/ic_info" />

    <Preference
      android:key="view_host_logs"
      android:title="@string/prefs_view_host_logs_title"
      android:summary="@string/prefs_view_host_logs_summary"
      android:icon="@drawable/ic_computer"
      android:dependency="host_logging_enabled" />

    <Preference
      android:key="view_audit_log"
      android:title="@string/prefs_view_audit_log_title"
      android:summary="@string/prefs_view_audit_log_summary"
      android:icon="@drawable/ic_security" />

  </PreferenceCategory>

  <PreferenceCategory
    android:key="category_logging_management"
    android:title="@string/prefcat_logging_management"
    android:icon="@drawable/ic_settings">

    <Preference
      android:key="export_logs"
      android:title="@string/prefs_export_logs_title"
      android:summary="@string/prefs_export_logs_summary"
      android:icon="@drawable/ic_download" />

    <Preference
      android:key="clear_logs"
      android:title="@string/prefs_clear_logs_title"
      android:summary="@string/prefs_clear_logs_summary"
      android:icon="@drawable/ic_clear" />

  </PreferenceCategory>

  <PreferenceCategory
    android:key="category_logging_paste"
    android:title="@string/prefcat_logging_paste"
    android:icon="@drawable/ic_share">

    <ListPreference
      android:key="paste_service"
      android:title="@string/prefs_paste_service_title"
      android:summary="@string/prefs_paste_service_summary"
      android:entries="@array/paste_service_labels"
      android:entryValues="@array/paste_service_values"
      android:defaultValue="stikked" />

    <EditTextPreference
      android:key="paste_stikked_url"
      android:title="@string/prefs_paste_stikked_url_title"
      android:defaultValue="https://pste.us"
      android:inputType="textUri"
      app:useSimpleSummaryProvider="true" />

    <EditTextPreference
      android:key="paste_microbin_url"
      android:title="@string/prefs_paste_microbin_url_title"
      android:defaultValue="https://mb.pste.us"
      android:inputType="textUri"
      app:useSimpleSummaryProvider="true" />

    <EditTextPreference
      android:key="paste_lenpaste_url"
      android:title="@string/prefs_paste_lenpaste_url_title"
      android:defaultValue="https://lp.pste.us"
      android:inputType="textUri"
      app:useSimpleSummaryProvider="true" />

    <EditTextPreference
      android:key="paste_pastebin_api_key"
      android:title="@string/prefs_paste_pastebin_api_key_title"
      android:summary="@string/prefs_paste_pastebin_api_key_summary"
      android:inputType="textPassword" />

  </PreferenceCategory>

</PreferenceScreen>
