<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

  <PreferenceCategory
    android:key="prefcat_main_app"
    android:title="@string/prefcat_main_app">

    <Preference
      android:key="general_settings"
      android:title="@string/prefs_general_settings_title"
      android:summary="@string/prefs_general_settings_summary"
      android:icon="@drawable/ic_settings_general"
      android:fragment="io.github.tabssh.ui.activities.GeneralSettingsFragment" />

    <Preference
      android:key="terminal_settings"
      android:title="@string/settings_terminal"
      android:summary="@string/prefs_terminal_settings_summary"
      android:icon="@drawable/ic_terminal"
      android:fragment="io.github.tabssh.ui.activities.TerminalSettingsFragment" />

    <Preference
      android:key="recording_settings"
      android:title="@string/prefs_recording_settings_title"
      android:summary="@string/prefs_recording_settings_summary"
      android:icon="@drawable/ic_videocam"
      android:fragment="io.github.tabssh.ui.activities.RecordingSettingsFragment" />

    <Preference
      android:key="security_settings"
      android:title="@string/prefs_security_settings_title"
      android:summary="@string/prefs_security_settings_summary"
      android:icon="@drawable/ic_security"
      android:fragment="io.github.tabssh.ui.activities.SecuritySettingsFragment" />

  </PreferenceCategory>

  <PreferenceCategory
    android:key="prefcat_main_connections"
    android:title="@string/prefcat_main_connections">

    <Preference
      android:key="connection_settings"
      android:title="@string/prefs_connection_settings_title"
      android:summary="@string/prefs_connection_settings_summary"
      android:icon="@drawable/ic_connection"
      android:fragment="io.github.tabssh.ui.activities.ConnectionSettingsFragment" />

    <Preference
      android:key="monitoring_settings"
      android:title="@string/host_detail_section_monitoring"
      android:summary="@string/prefs_monitoring_settings_summary"
      android:icon="@drawable/ic_flash"
      android:fragment="io.github.tabssh.ui.activities.MonitoringSettingsFragment" />

  </PreferenceCategory>

  <!-- Sync sits with Import/Export because both move the same data; it is not a
       connectivity setting even though it talks to a remote service. -->
  <PreferenceCategory
    android:key="prefcat_main_data"
    android:title="@string/prefcat_main_data">

    <Preference
      android:key="sync_settings"
      android:title="@string/prefs_sync_settings_title"
      android:summary="@string/prefs_sync_settings_summary"
      android:icon="@drawable/ic_refresh" />

    <Preference
      android:key="import_export"
      android:title="@string/prefs_import_export_title"
      android:summary="@string/prefs_import_export_summary"
      android:icon="@drawable/ic_import_export" />

    <Preference
      android:key="tasker_settings"
      android:title="@string/prefs_tasker_settings_title"
      android:summary="@string/prefs_tasker_settings_summary"
      android:icon="@drawable/ic_settings"
      android:fragment="io.github.tabssh.ui.activities.TaskerSettingsFragment" />

  </PreferenceCategory>

  <PreferenceCategory
    android:key="prefcat_main_diagnostics"
    android:title="@string/prefcat_main_diagnostics">

    <Preference
      android:key="logging_settings"
      android:title="@string/prefs_logging_settings_title"
      android:summary="@string/prefs_logging_settings_summary"
      android:icon="@drawable/ic_logs"
      android:fragment="io.github.tabssh.ui.activities.LoggingSettingsFragment" />

    <Preference
      android:key="audit_settings"
      android:title="@string/prefs_audit_settings_title"
      android:summary="@string/prefs_audit_settings_summary"
      android:icon="@drawable/ic_security"
      android:fragment="io.github.tabssh.ui.activities.AuditSettingsFragment" />

  </PreferenceCategory>

  <!-- Summaries are replaced at runtime by SettingsMainFragment from BuildConfig. -->
  <PreferenceCategory
    android:key="prefcat_main_about"
    android:title="@string/nav_item_about">

    <Preference
      android:key="about_version"
      android:title="@string/prefs_about_version_title"
      android:summary="@string/prefs_about_loading_summary"
      android:icon="@drawable/ic_info"
      android:selectable="false" />

    <Preference
      android:key="about_build"
      android:title="@string/prefs_about_build_title"
      android:summary="@string/prefs_about_loading_summary"
      android:icon="@drawable/ic_info"
      android:selectable="false" />

  </PreferenceCategory>

</PreferenceScreen>
