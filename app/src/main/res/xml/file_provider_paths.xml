<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Internal storage for temporary files -->
    <files-path name="internal_files" path="." />
    
    <!-- Cache directory for temporary files -->
    <cache-path name="cache" path="." />

    <!-- file:// "Open" round trip — downloaded SFTP files handed to
         external viewers/editors via FileProvider (RemoteFileOpener). -->
    <cache-path name="file_links" path="file-links/" />

    <!-- External storage for downloads -->
    <external-files-path name="downloads" path="Downloads/" />
    
    <!-- SSH key exports -->
    <files-path name="keys" path="keys/" />
    
    <!-- Backup exports -->
    <files-path name="backups" path="backups/" />

    <!-- Session video recordings (mp4/.cast) on pre-API-29 devices, where
         VideoRecordingStorage falls back to a direct public-storage path
         instead of MediaStore's own content:// Uris. -->
    <external-path name="recordings" path="Movies/TabSSH/" />
</paths>
