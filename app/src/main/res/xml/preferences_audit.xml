<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <!-- MDM status banner — shown/hidden and populated at runtime by SettingsActivity
       when isMdmManaged() is true. The key is used to find the preference. -->
  <Preference
    android:key="audit_mdm_status"
    android:title="@string/prefs_audit_mdm_status_title"
    android:summary="@string/prefs_audit_mdm_status_summary"
    android:icon="@drawable/ic_security"
    android:selectable="false"
    android:visible="false" />

  <PreferenceCategory
    android:key="category_audit_logging"
    android:title="@string/prefcat_audit_logging">

    <!-- Toggle is greyed out when MDM forces the value. -->
    <SwitchPreferenceCompat
      android:key="audit_log_enabled"
      android:title="@string/prefs_audit_log_enabled_title"
      android:summary="@string/prefs_audit_log_enabled_summary"
      android:defaultValue="false"
      android:icon="@drawable/ic_logs" />

    <EditTextPreference
      android:key="audit_log_max_size_mb"
      android:title="@string/prefs_audit_log_max_size_mb_title"
      android:summary="@string/prefs_audit_log_max_size_mb_summary"
      android:defaultValue="100"
      android:inputType="number"
      android:dependency="audit_log_enabled"
      app:useSimpleSummaryProvider="true" />

    <EditTextPreference
      android:key="audit_log_max_age_days"
      android:title="@string/prefs_audit_log_max_age_days_title"
      android:summary="@string/prefs_audit_log_max_age_days_summary"
      android:defaultValue="30"
      android:inputType="number"
      android:dependency="audit_log_enabled"
      app:useSimpleSummaryProvider="true" />

  </PreferenceCategory>

  <PreferenceCategory
    android:key="category_audit_events"
    android:title="@string/prefcat_audit_events">

    <SwitchPreferenceCompat
      android:key="audit_log_commands"
      android:title="@string/prefs_audit_log_commands_title"
      android:summary="@string/prefs_audit_log_commands_summary"
      android:defaultValue="true"
      android:dependency="audit_log_enabled" />

    <SwitchPreferenceCompat
      android:key="audit_log_output"
      android:title="@string/prefs_audit_log_output_title"
      android:summary="@string/prefs_audit_log_output_summary"
      android:defaultValue="false"
      android:dependency="audit_log_enabled" />

    <!-- Auth, host-key, SFTP, and port-forward events are always recorded
         when audit logging is enabled; they are not individually toggleable
         because they are the core of what an audit log is for. -->
    <Preference
      android:key="audit_events_info"
      android:title="@string/prefs_audit_events_info_title"
      android:summary="@string/prefs_audit_events_info_summary"
      android:selectable="false"
      android:dependency="audit_log_enabled" />

  </PreferenceCategory>

  <PreferenceCategory
    android:key="category_audit_actions"
    android:title="@string/prefcat_audit_actions">

    <Preference
      android:key="audit_log_viewer"
      android:title="@string/prefs_audit_log_viewer_title"
      android:summary="@string/prefs_audit_log_viewer_summary"
      android:dependency="audit_log_enabled" />

    <Preference
      android:key="audit_log_export"
      android:title="@string/prefs_audit_log_export_title"
      android:summary="@string/prefs_audit_log_export_summary"
      android:dependency="audit_log_enabled" />

    <Preference
      android:key="audit_log_clear"
      android:title="@string/prefs_audit_log_clear_title"
      android:summary="@string/prefs_audit_log_clear_summary"
      android:dependency="audit_log_enabled" />

  </PreferenceCategory>

</androidx.preference.PreferenceScreen>
