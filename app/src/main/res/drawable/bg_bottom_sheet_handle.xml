<?xml version="1.0" encoding="utf-8"?>
<!--
    Drag-handle pill for bottom sheets. Uses the theme's outline-variant
    token so the handle stays a subtle, low-contrast pill that reads
    correctly on both dark and light MD3 surfaces, matching the Material
    Design 3 drag-handle guidance for a 32x4dp rounded pill.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorOutlineVariant" />
    <corners android:radius="2dp" />
</shape>
