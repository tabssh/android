    <!-- Issue #37 — Remote command presets for ConnectionEditActivity.
         Index 0 (Default — login shell) saves null/empty.
         Last item (Custom…) reveals the EditText for arbitrary input.
         Order matters: the activity treats the first entry as "no command"
         and the last entry as "show custom field". -->
    <string-array name="remote_command_entries">
        <item>@string/arr_remote_command_default_login_shell</item>
        <item>@string/arr_remote_command_sftp_sftp_only_accounts</item>
        <item>@string/arr_remote_command_internal_sftp_openssh_sftp_s</item>
        <item>@string/arr_remote_command_tmux_attach_d_tmux_new_auto</item>
        <item>@string/arr_remote_command_screen_dr_auto_attach_to_scr</item>
        <item>@string/arr_remote_command_create_sourceforge_shell_sou</item>
        <item>@string/arr_remote_command_custom</item>
    </string-array>
    <!-- Parallel values array — index N matches `remote_command_entries[N]`.
         Index 0 (default) is the empty string. Index last (Custom…) is also
         empty — the activity reads the EditText instead. -->
    <string-array name="remote_command_values">
        <item></item>
        <item>sftp</item>
        <item>internal-sftp</item>
        <item>tmux attach -d || tmux new</item>
        <item>screen -DR</item>
        <item>create</item>
        <item></item>
    </string-array>

