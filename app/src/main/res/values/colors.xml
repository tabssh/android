    <color name="accent_800">#FF6A1B9A</color>
    <color name="accent_900">#FF4A148C</color>
    
    <!-- Semantic colors -->
    <color name="success">#FF4CAF50</color>
    <color name="success_dark">#FF388E3C</color>
    <color name="warning">#FFFF9800</color>
    <color name="warning_dark">#FFF57C00</color>
    <color name="error">#FFF44336</color>
    <color name="error_dark">#FFD32F2F</color>
    <color name="info">#FF2196F3</color>
    <color name="info_dark">#FF1976D2</color>

    <!-- Neutral colors -->
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>
    <color name="gray_50">#FFFAFAFA</color>
    <color name="gray_100">#FFF5F5F5</color>
    <color name="gray_200">#FFEEEEEE</color>
    <color name="gray_300">#FFE0E0E0</color>
    <color name="gray_400">#FFBDBDBD</color>
    <color name="gray_500">#FF9E9E9E</color>
    <color name="gray_600">#FF757575</color>
    <color name="gray_700">#FF616161</color>
    <color name="gray_800">#FF424242</color>
    <color name="gray_900">#FF212121</color>
    
    <!-- Terminal default colors (will be overridden by themes) -->
    <color name="terminal_background">#FF000000</color>
    <color name="terminal_foreground">#FFFFFFFF</color>
    <color name="terminal_cursor">#FFFFFFFF</color>
    <color name="terminal_selection">#FF0066FF</color>
    <color name="terminal_green">#FF4CAF50</color>
    <color name="terminal_link">#FF4FC3F7</color>
    <color name="terminal_bell_flash">#40FFFFFF</color>
    
    <!-- UI specific colors -->
    <color name="tab_background">#FFF5F5F5</color>
    <color name="tab_text">#FF212121</color>
    <color name="tab_selected">#FF1976D2</color>
    <color name="tab_indicator">#FF1976D2</color>
    

    <!-- Material Design 3 colors -->
    <color name="surface">#FFFFFFFF</color>
    <color name="surface_variant">#FFF5F5F5</color>
    <color name="on_surface">#FF212121</color>
    <!-- on_surface_variant bumped from #616161 (5.7:1, borderline AA) to
         #424242 (~10:1) so secondary labels and section subtitles in light
         mode read clearly against the slightly-tinted Material3 surface
         instead of fading toward invisible (Issue #35). -->
    <color name="on_surface_variant">#FF424242</color>
    <color name="outline">#FFE0E0E0</color>
    <color name="outline_variant">#FFF5F5F5</color>
    
    <!-- Metric gauge thresholds (dashboard progress bars) -->
    <color name="gauge_ok">@color/success</color>
    <color name="gauge_warn">@color/warning</color>
    <color name="gauge_critical">@color/error</color>

    <!-- Status text colors — darker day tones so small status labels meet
         WCAG AA on light surfaces; values-night swaps in lighter 300-tones
         (same pattern as gauge_* above) -->
    <color name="status_success">#FF2E7D32</color>
    <color name="status_warning">#FFBF360C</color>
    <color name="status_error">#FFC62828</color>
    <color name="status_info">#FF1565C0</color>
    <color name="status_neutral">#FF616161</color>
    <!-- Overdue tier (past a tracked renewal date) — deliberately a distinct
         hue from status_error, not just a darker red, so "overdue" and
         "renews very soon" never read as the same color at a glance -->
    <color name="status_overdue">#FF6A1B9A</color>

    <!-- Tinted status container backgrounds (banner cards in the host-key
         dialogs); values-night swaps in dark tints -->
    <color name="status_success_container">#FFE8F5E9</color>
    <color name="status_warning_container">#FFFFF3E0</color>
    <color name="status_error_container">#FFFFEBEE</color>
    <color name="status_info_container">#FFE3F2FD</color>
    <color name="status_overdue_container">#FFF3E5F5</color>
    <color name="status_neutral_container">#FFF5F5F5</color>

    <!-- Translucent primary tint for selected list rows (file manager);
         values-night lightens the base hue -->
    <color name="selection_tint">#221976D2</color>

    <!-- Crash-report console inset — intentionally dark in both modes, like a
         terminal well; error text is a light red that passes AA on #111111 -->
    <color name="console_background">#FF111111</color>
    <color name="console_error_text">#FFFF6E6E</color>

    <!-- VNC toolbar overlay — floats over the remote framebuffer, so it keeps
         a constant dark scrim with light dividers in both modes -->
    <color name="vnc_toolbar_scrim">#CC1A1A1A</color>
    <color name="vnc_toolbar_divider">#44FFFFFF</color>

    <!-- Panes grid — focused-tile border; brightened in values-night -->
    <color name="pane_focus_border">#FF4CAF50</color>
    <!-- Panes grid close button — floats over live terminal content, so it
         keeps a constant dark scrim with white glyph in both modes -->
    <color name="pane_close_scrim">#99000000</color>

    <!-- Keyboard customization key categories -->
    <color name="keyboard_key_modifier">@color/info</color>
    <color name="keyboard_key_arrow">@color/success</color>
    <color name="keyboard_key_function">@color/warning</color>
    <color name="keyboard_key_symbol">@color/accent_500</color>
    <color name="keyboard_key_action">#FFE91E63</color>

    <!-- Multi-row keyboard latched-key state — constant green fill with dark
         green label in both modes (the fill covers the key, so the surface
         color underneath is irrelevant; ~4.7:1 contrast) -->
    <color name="keyboard_key_active_fill">#FF4CAF50</color>
    <color name="keyboard_key_active_text">#FF1B5E20</color>

    <!-- Performance chart line -->
    <color name="chart_cpu_line">@color/primary_500</color>
</resources>
