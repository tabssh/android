<?xml version="1.0" encoding="utf-8"?>
<!--
  Navigation drawer — items that are accessible via a main tab are NOT
  duplicated here; the drawer covers everything that has no natural tab home.

  Groups: Quick → Accounts → Manage → Connect → Insights → Settings → Diagnostics
  Tabs handle: Frequent | Hosts | Panes | Infra | Auth
  Stats moved here (Insights group, above Multi-host Dashboard) — it is no
  longer a main tab.
  Import/Export moved to Settings screen.
  Quick.Home always returns to MainActivity's last-used tab (see
  TabSSHActivity.goHome()) — the only drawer path back to the main tab UI
  once you've drilled into a tracker/manager screen.

  TabSSHActivity hosts this menu on every screen, so every destination here
  is reachable from anywhere in the app.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Quick: one-shot actions that don't live in any tab -->
    <group android:id="@+id/group_quick">
        <item
            android:id="@+id/nav_home"
            android:icon="@android:drawable/ic_menu_myplaces"
            android:title="@string/nav_item_home" />
        <item
            android:id="@+id/nav_quick_connect"
            android:icon="@drawable/ic_flash"
            android:title="@string/nav_item_quick_connect" />
    </group>

    <item android:title="@string/nav_group_accounts">
        <menu>
            <item
                android:id="@+id/nav_vnc_hosts"
                android:icon="@android:drawable/ic_menu_view"
                android:title="@string/nav_item_vnc_hosts" />
        </menu>
    </item>

    <item android:title="@string/nav_group_manage">
        <menu>
            <item
                android:id="@+id/nav_snippets"
                android:icon="@drawable/ic_code"
                android:title="@string/nav_item_snippets" />
            <item
                android:id="@+id/nav_manage_groups"
                android:icon="@android:drawable/ic_menu_agenda"
                android:title="@string/nav_item_groups" />
        </menu>
    </item>

    <item android:title="@string/nav_group_connect">
        <menu>
            <item
                android:id="@+id/nav_port_forwarding"
                android:icon="@drawable/ic_forward"
                android:title="@string/port_forwarding_title" />
            <item
                android:id="@+id/nav_cluster_commands"
                android:icon="@android:drawable/ic_menu_share"
                android:title="@string/nav_item_cluster_commands" />
        </menu>
    </item>

    <item android:title="@string/nav_group_insights">
        <menu>
            <item
                android:id="@+id/nav_stats"
                android:icon="@android:drawable/ic_menu_sort_by_size"
                android:title="@string/main_tab_stats" />
            <item
                android:id="@+id/nav_multi_dashboard"
                android:icon="@android:drawable/ic_menu_view"
                android:title="@string/nav_item_multi_host_dashboard" />
            <item
                android:id="@+id/nav_connection_history"
                android:icon="@android:drawable/ic_menu_recent_history"
                android:title="@string/nav_item_connection_history" />
            <item
                android:id="@+id/nav_domain_tracker"
                android:icon="@android:drawable/ic_menu_mapmode"
                android:title="@string/nav_item_domain_tracker" />
            <item
                android:id="@+id/nav_vps_tracker"
                android:icon="@android:drawable/ic_menu_manage"
                android:title="@string/nav_item_vps_tracker" />
        </menu>
    </item>

    <group android:id="@+id/group_settings">
        <item
            android:id="@+id/nav_settings"
            android:icon="@drawable/ic_settings"
            android:title="@string/nav_item_settings" />
    </group>

    <item android:title="@string/nav_group_diagnostics">
        <menu>
            <item
                android:id="@+id/nav_copy_app_log"
                android:icon="@android:drawable/ic_menu_recent_history"
                android:title="@string/nav_item_copy_app_log" />
            <item
                android:id="@+id/nav_copy_debug_logs"
                android:icon="@android:drawable/ic_menu_info_details"
                android:title="@string/nav_item_copy_debug_logs" />
            <item
                android:id="@+id/nav_whats_new"
                android:icon="@drawable/ic_info"
                android:title="@string/nav_item_whats_new" />
            <item
                android:id="@+id/nav_help"
                android:icon="@drawable/ic_help"
                android:title="@string/nav_item_help" />
            <item
                android:id="@+id/nav_about"
                android:icon="@drawable/ic_info"
                android:title="@string/nav_item_about" />
        </menu>
    </item>

</menu>
