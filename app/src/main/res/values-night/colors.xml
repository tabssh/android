<?xml version="1.0" encoding="utf-8"?>
<!--
  Night-mode color overrides. These names match the ones in
  values/colors.xml but resolve to dark equivalents whenever the
  device (or user pref via setDefaultNightMode) is in night mode.

  Without this file, Theme.TabSSH (which references @color/surface,
  @color/on_surface, @color/outline, …) would always resolve to the
  light values and the user-facing "App theme = Dark" preference
  would have no visible effect on activity backgrounds.

  The actual hex values mirror the `*_dark` siblings already present
  in values/colors.xml — kept in this separate file so non-night-mode
  callers can still reference the explicit `*_dark` names directly
  when they really need a dark color regardless of mode (e.g. terminal
  output backgrounds).
-->
<resources>
    <!-- Surfaces & on-surface text -->
    <color name="surface">#FF121212</color>
    <color name="surface_variant">#FF1E1E1E</color>
    <color name="on_surface">#FFFFFFFF</color>
    <color name="on_surface_variant">#FFBDBDBD</color>

    <!-- Outlines -->
    <color name="outline">#FF424242</color>
    <color name="outline_variant">#FF2C2C2C</color>

    <!-- Tab strip uses surface on day; in night just stay dark too -->
    <color name="tab_background">#FF1E1E1E</color>
    <color name="tab_text">#FFFFFFFF</color>

    <!-- Lighter Material 300-tone hues so gauge bars, keyboard category
         labels, and the CPU chart line keep contrast on dark surfaces -->
    <color name="gauge_ok">#FF81C784</color>
    <color name="gauge_warn">#FFFFB74D</color>
    <color name="gauge_critical">#FFE57373</color>
    <color name="keyboard_key_modifier">#FF64B5F6</color>
    <color name="keyboard_key_arrow">#FF81C784</color>
    <color name="keyboard_key_function">#FFFFB74D</color>
    <color name="keyboard_key_symbol">#FFBA68C8</color>
    <color name="keyboard_key_action">#FFF06292</color>
    <color name="chart_cpu_line">#FF64B5F6</color>

    <!-- Status text — lighter 300-tones for contrast on dark surfaces -->
    <color name="status_success">#FF81C784</color>
    <color name="status_warning">#FFFFB74D</color>
    <color name="status_error">#FFE57373</color>
    <color name="status_info">#FF64B5F6</color>
    <color name="status_neutral">#FF9E9E9E</color>
    <color name="status_overdue">#FFCE93D8</color>

    <!-- Tinted status container backgrounds — dark tints of the day pastels -->
    <color name="status_success_container">#FF16281D</color>
    <color name="status_warning_container">#FF2E2113</color>
    <color name="status_error_container">#FF2E1616</color>
    <color name="status_info_container">#FF16282A</color>
    <color name="status_overdue_container">#FF241A29</color>
    <color name="status_neutral_container">#FF2A2A2A</color>

    <!-- Selected-row tint — lighter base hue so it reads on dark surfaces -->
    <color name="selection_tint">#2264B5F6</color>
</resources>
