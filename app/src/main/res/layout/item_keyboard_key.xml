<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_xs"
    app:cardElevation="@dimen/elevation_low"
    app:cardCornerRadius="@dimen/card_corner_radius_small">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_12dp"
        android:gravity="center">

        <TextView
            android:id="@+id/key_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kbdcustom_key_label_placeholder"
            android:textSize="@dimen/text_size_subtitle"
            android:textStyle="bold"
            android:minWidth="@dimen/min_touch_target"
            android:gravity="center" />

        <TextView
            android:id="@+id/key_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kbdcustom_key_description_placeholder"
            android:textSize="@dimen/text_size_overline"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:paddingTop="@dimen/space_2dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
