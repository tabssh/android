<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_md">

    <TextView
        android:id="@+id/job_name_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/backup_runs_job_name_loading"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/space_md" />

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginBottom="@dimen/space_md" />

    <TextView
        android:id="@+id/empty_state_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/backup_runs_empty_state"
        android:textAlignment="center"
        android:textSize="16sp"
        android:visibility="gone"
        android:layout_marginTop="@dimen/space_xl"
        android:layout_marginBottom="@dimen/space_xl" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/backup_runs_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="200dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/space_md">

        <Button
            android:id="@+id/refresh_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/container_refresh"
            android:layout_marginEnd="@dimen/space_sm"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <Button
            android:id="@+id/close_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/close"
            android:layout_marginStart="@dimen/space_sm"
            style="@style/Widget.Material3.Button" />
    </LinearLayout>

</LinearLayout>
