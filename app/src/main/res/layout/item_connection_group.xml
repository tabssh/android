<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="@dimen/space_md"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical">

    <!-- Group color indicator -->
    <View
        android:id="@+id/view_group_color"
        android:layout_width="@dimen/scrollbar_width"
        android:layout_height="match_parent"
        android:layout_marginEnd="@dimen/space_12dp"
        android:visibility="gone" />

    <!-- Expand/collapse icon -->
    <ImageView
        android:id="@+id/icon_expand"
        android:layout_width="@dimen/icon_size_medium"
        android:layout_height="@dimen/icon_size_medium"
        android:layout_marginEnd="@dimen/space_12dp"
        android:src="@drawable/ic_expand_more"
        android:contentDescription="@string/item_group_expand_collapse_content_description" />

    <!-- Group name and connection count -->
    <TextView
        android:id="@+id/text_group_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="@dimen/text_size_subtitle"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:text="@string/item_connection_group_name_placeholder" />

</LinearLayout>
