<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:padding="@dimen/space_20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Welcome Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/status_success_container"
            android:padding="@dimen/space_md"
            android:layout_marginBottom="@dimen/space_20dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dialog_new_host_key_header_title"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="@color/status_success"
                android:gravity="center"
                android:paddingBottom="@dimen/space_sm" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dialog_new_host_key_header_subtitle"
                android:textSize="13sp"
                android:textColor="@color/status_success"
                android:gravity="center"
                android:alpha="0.9" />

        </LinearLayout>

        <!-- Server Information Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md"
            style="?attr/materialCardViewFilledStyle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_new_host_key_server_label"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:paddingBottom="@dimen/space_xs" />

                <TextView
                    android:id="@+id/text_hostname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    tools:text="example.com:22" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Key Information Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md"
            style="?attr/materialCardViewOutlinedStyle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md"
                android:background="@color/status_info_container">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_new_host_key_public_key_title"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/status_info"
                    android:paddingBottom="@dimen/space_sm" />

                <TextView
                    android:id="@+id/text_key_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:paddingBottom="@dimen/space_sm"
                    android:textColor="@color/status_info"
                    tools:text="Key Type: ssh-ed25519" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_new_host_key_fingerprint_label"
                    android:textSize="12sp"
                    android:textColor="@color/status_info"
                    android:paddingBottom="@dimen/space_xs" />

                <TextView
                    android:id="@+id/text_fingerprint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textIsSelectable="true"
                    android:background="?attr/colorSurface"
                    android:padding="@dimen/space_sm"
                    android:textColor="?android:attr/textColorPrimary"
                    tools:text="SHA256:abc123def456..." />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Security Guidance Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="?attr/materialCardViewElevatedStyle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md"
                android:background="?attr/colorSurface">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_new_host_key_verification_title"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="?attr/colorPrimary"
                    android:paddingBottom="@dimen/space_12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_new_host_key_verification_body"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12dp"
                    android:text="@string/dialog_new_host_key_trust_hint"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
