<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_12dp"
    android:layout_marginEnd="@dimen/space_12dp"
    android:layout_marginTop="@dimen/space_xs"
    android:layout_marginBottom="@dimen/space_xs"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/elevation_low"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_12dp">

        <!-- ── Title row ─────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Status dot -->
            <View
                android:id="@+id/status_dot"
                android:layout_width="@dimen/connection_status_indicator_size"
                android:layout_height="@dimen/connection_status_indicator_size"
                android:background="@drawable/bg_circle"
                android:backgroundTint="?attr/colorOutline"
                android:layout_marginEnd="@dimen/space_sm" />

            <!-- Host display name -->
            <TextView
                android:id="@+id/tv_hostname"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="?attr/colorOnSurface"
                android:ellipsize="end"
                android:maxLines="1" />

            <!-- OS icon (emoji) -->
            <TextView
                android:id="@+id/tv_os_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_subtitle"
                android:paddingEnd="@dimen/space_xs" />

            <!-- Monitor bell button -->
            <ImageButton
                android:id="@+id/btn_monitor"
                android:layout_width="@dimen/min_touch_target"
                android:layout_height="@dimen/min_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/dashboard_context_monitor_settings"
                app:srcCompat="@drawable/ic_notification"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- Host address / OS subtitle -->
        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:paddingStart="@dimen/space_18dp"
            android:layout_marginBottom="@dimen/space_sm"
            android:ellipsize="end"
            android:maxLines="1" />

        <!-- ── CPU row ──────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/space_xs">

            <TextView
                android:layout_width="@dimen/dashboard_stat_label_width"
                android:layout_height="wrap_content"
                android:text="@string/host_detail_label_cpu"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/pb_cpu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_marginEnd="@dimen/space_xs"
                app:trackThickness="@dimen/space_6dp"
                app:trackCornerRadius="@dimen/progress_track_corner_radius"
                app:indicatorColor="@color/accent_500"
                app:trackColor="?attr/colorSurfaceVariant" />

            <TextView
                android:id="@+id/tv_cpu"
                android:layout_width="@dimen/dashboard_stat_value_width"
                android:layout_height="wrap_content"
                android:text="@string/host_detail_value_unavailable"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="?attr/colorOnSurface"
                android:gravity="end" />

        </LinearLayout>

        <!-- ── Memory row ───────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/space_xs">

            <TextView
                android:layout_width="@dimen/dashboard_stat_label_width"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_host_card_mem_label"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/pb_mem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_marginEnd="@dimen/space_xs"
                app:trackThickness="@dimen/space_6dp"
                app:trackCornerRadius="@dimen/progress_track_corner_radius"
                app:indicatorColor="?attr/colorPrimary"
                app:trackColor="?attr/colorSurfaceVariant" />

            <TextView
                android:id="@+id/tv_mem"
                android:layout_width="@dimen/dashboard_stat_value_width"
                android:layout_height="wrap_content"
                android:text="@string/host_detail_value_unavailable"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="?attr/colorOnSurface"
                android:gravity="end" />

        </LinearLayout>

        <!-- ── Disk row ─────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/space_sm">

            <TextView
                android:layout_width="@dimen/dashboard_stat_label_width"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_host_card_disk_label"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/pb_disk"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_marginEnd="@dimen/space_xs"
                app:trackThickness="@dimen/space_6dp"
                app:trackCornerRadius="@dimen/progress_track_corner_radius"
                app:indicatorColor="?attr/colorTertiary"
                app:trackColor="?attr/colorSurfaceVariant" />

            <TextView
                android:id="@+id/tv_disk"
                android:layout_width="@dimen/dashboard_stat_value_width"
                android:layout_height="wrap_content"
                android:text="@string/host_detail_value_unavailable"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="?attr/colorOnSurface"
                android:gravity="end" />

        </LinearLayout>

        <!-- ── Load / Uptime row ─────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/space_2dp">

            <TextView
                android:id="@+id/tv_load"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dashboard_host_card_load_placeholder"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tv_uptime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_host_card_uptime_placeholder"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- ── Network / Processes row ──────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_net"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dashboard_host_card_net_placeholder"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tv_procs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_host_card_procs_placeholder"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
