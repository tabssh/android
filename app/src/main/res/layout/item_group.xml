<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_sm"
    app:cardElevation="@dimen/elevation_low"
    app:cardCornerRadius="@dimen/card_corner_radius_small">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_md"
        android:gravity="center_vertical">

        <!-- Color indicator -->
        <View
            android:id="@+id/view_color_indicator"
            android:layout_width="@dimen/scrollbar_width"
            android:layout_height="@dimen/min_touch_target"
            android:layout_marginEnd="@dimen/space_md"
            android:background="?attr/colorPrimary" />

        <!-- Group info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_group_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/group_mgmt_edit_name_hint"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_group_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/item_group_connections_placeholder"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?android:attr/textColorSecondary" />

        </LinearLayout>

        <!-- Drag handle -->
        <ImageView
            android:id="@+id/icon_drag_handle"
            android:layout_width="@dimen/icon_size_medium"
            android:layout_height="@dimen/icon_size_medium"
            android:layout_marginStart="@dimen/space_sm"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:contentDescription="@string/item_group_drag_content_description"
            android:alpha="0.5" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
