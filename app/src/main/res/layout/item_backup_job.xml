<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_xs"
    app:cardElevation="@dimen/elevation_low"
    app:cardCornerRadius="@dimen/card_corner_radius_small">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_12dp">

        <!-- Job Name -->
        <TextView
            android:id="@+id/job_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/backup_job_item_name_placeholder"
            android:textSize="@dimen/text_size_subtitle"
            android:textStyle="bold" />

        <!-- Job Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_xs">

            <TextView
                android:id="@+id/job_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/backup_job_item_mode_placeholder"
                android:textSize="@dimen/text_size_caption"
                android:textColor="?android:textColorSecondary" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/job_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/backup_job_item_status_enabled_placeholder"
                android:textSize="@dimen/text_size_caption"
                android:textColor="@android:color/holo_green_dark" />

        </LinearLayout>

        <!-- Schedule -->
        <TextView
            android:id="@+id/job_schedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/backup_job_item_schedule_placeholder"
            android:textSize="@dimen/text_size_caption"
            android:textColor="?android:textColorSecondary"
            android:layout_marginTop="@dimen/space_xs" />

        <!-- VM Count -->
        <TextView
            android:id="@+id/job_vms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/backup_job_item_vms_placeholder"
            android:textSize="@dimen/text_size_caption"
            android:textColor="?android:textColorSecondary"
            android:layout_marginTop="@dimen/space_2dp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_sm">

            <Button
                android:id="@+id/trigger_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/backup_job_item_trigger_now"
                style="@style/Widget.Material3.Button.TonalButton" />

            <Button
                android:id="@+id/view_runs_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/backup_job_item_view_runs"
                android:layout_marginStart="@dimen/space_sm"
                style="@style/Widget.Material3.Button.OutlinedButton" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
