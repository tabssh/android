<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/app_bar"
        layout="@layout/include_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <!-- Server Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/xcpng_manager_server_label"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="@dimen/space_sm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/server_spinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Button
                android:id="@+id/add_server_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/xcpng_manager_add_button_text"
                style="@style/Widget.Material3.Button.TonalButton" />

        </LinearLayout>

        <!-- Refresh Button -->
        <Button
            android:id="@+id/refresh_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/xcpng_manager_refresh_vms"
            android:layout_marginTop="@dimen/space_sm"
            style="@style/Widget.Material3.Button" />
        
        <!-- Backup Jobs Button (XO only) -->
        <Button
            android:id="@+id/backup_jobs_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/xcpng_manager_backup_jobs"
            android:layout_marginTop="@dimen/space_sm"
            android:visibility="gone"
            style="@style/Widget.Material3.Button.TonalButton" />

        <!-- Show Infrastructure Button (XO only) -->
        <Button
            android:id="@+id/infrastructure_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/xcpng_manager_show_infrastructure"
            android:layout_marginTop="@dimen/space_sm"
            android:visibility="gone"
            style="@style/Widget.Material3.Button.TonalButton" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:visibility="gone"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:indeterminate="true" />

        <!-- Status Text -->
        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/xcpng_manager_no_server_selected"
            android:textAlignment="center"
            android:padding="@dimen/space_sm" />
        
        <!-- Live indicator for WebSocket connection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/space_xs"
            android:gravity="center">
            
            <View
                android:id="@+id/live_indicator"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@android:color/holo_green_light"
                android:visibility="gone" />
            
            <TextView
                android:id="@+id/live_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/xcpng_manager_live_updates"
                android:textSize="12sp"
                android:textColor="?android:textColorSecondary"
                android:layout_marginStart="@dimen/space_sm"
                android:visibility="gone" />
        
        </LinearLayout>

    </LinearLayout>

    <!-- VM List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/vm_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/space_sm" />

</LinearLayout>
