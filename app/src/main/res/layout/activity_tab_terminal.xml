<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activities.TabTerminalActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:minHeight="@dimen/toolbar_height"
            app:titleTextAppearance="@style/TextAppearance.TabSSH.Toolbar.Title"
            app:contentInsetStartWithNavigation="@dimen/space_none"
            style="@style/Widget.TabSSH.Toolbar" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tab_height"
            app:tabMode="scrollable"
            app:tabGravity="start"
            app:tabMaxWidth="@dimen/tab_max_width"
            app:tabMinWidth="@dimen/tab_min_width"
            style="@style/Widget.TabSSH.TabLayout" />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/pager_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <!-- Terminal display area with ViewPager2 for swipe support -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/terminal_background" />

        <!-- Single terminal view (used when swipe is disabled) -->
        <io.github.tabssh.ui.views.TerminalView
            android:id="@+id/terminal_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/terminal_background"
            android:visibility="gone"
            app:terminalFontSize="@dimen/terminal_text_size_default"
            app:terminalFontFamily="monospace"
            app:showScrollbar="true"
            app:scrollbackLines="1000" />

        <!-- Find-in-scrollback overlay bar. Managed by ScrollbackSearchController. -->
        <include
            android:id="@+id/search_overlay"
            layout="@layout/overlay_search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top" />

        <!-- Menu FAB. Hidden by default — the primary entry is the
             "☰" key on the multi-row keyboard bar (already always
             visible at the bottom). The FAB is retained as a fallback
             reachable via the top-left edge tap gesture for users who
             hide the custom keyboard bar entirely. -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_marginTop="@dimen/space_sm"
            android:src="@drawable/ic_menu"
            android:contentDescription="@string/tab_terminal_menu_button_open_description"
            app:fabSize="mini"
            app:backgroundTint="?attr/colorSecondaryContainer"
            app:tint="?attr/colorOnSecondaryContainer"
            app:elevation="@dimen/space_6dp"
            android:visibility="gone" />

        <!-- Multiplexer Status Indicator -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chip_multiplexer_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginEnd="@dimen/space_sm"
            android:text="@string/tab_terminal_multiplexer_chip_default"
            android:textSize="@dimen/text_size_overline"
            app:chipBackgroundColor="@color/terminal_green"
            app:chipMinHeight="@dimen/icon_size_medium"
            app:chipIcon="@drawable/ic_terminal"
            app:chipIconSize="14dp"
            app:chipIconTint="@android:color/white"
            android:textColor="@android:color/white"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />

        <!-- Edge-swipe reject feedback. A brief alpha-fade glow spanning the
             full vertical edge (not just a centered strip) shown at the
             screen edge nearer the touch point when a mid-screen swipe is
             rejected by the edge-zone gate in attachEdgeSwipeGate() — makes
             the gate read as "by design" instead of "broken". Animated from
             TabTerminalActivity; alpha=0 (invisible) until triggered. -->
        <View
            android:id="@+id/swipe_edge_glow_start"
            android:layout_width="@dimen/space_18dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@drawable/swipe_edge_glow_start"
            android:alpha="0"
            android:importantForAccessibility="no" />

        <View
            android:id="@+id/swipe_edge_glow_end"
            android:layout_width="@dimen/space_18dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="@drawable/swipe_edge_glow_end"
            android:alpha="0"
            android:importantForAccessibility="no" />

        </FrameLayout>

        <!-- Wave 2.8 — Split-view bottom pane. Hidden until user invokes
             "Split current view…". Hosts a separate SSHTab + TerminalView. -->
        <FrameLayout
            android:id="@+id/split_bottom_pane"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/terminal_background"
            android:visibility="gone">

            <io.github.tabssh.ui.views.TerminalView
                android:id="@+id/split_bottom_terminal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/terminal_background"
                app:terminalFontSize="@dimen/terminal_text_size_default"
                app:terminalFontFamily="monospace"
                app:showScrollbar="true"
                app:scrollbackLines="1000" />

        </FrameLayout>

        <!-- Multi-Row Custom Keyboard -->
        <io.github.tabssh.ui.keyboard.MultiRowKeyboardView
            android:id="@+id/multi_row_keyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurfaceVariant"
            android:visibility="visible" />

        <!-- Compact bottom action bar. Hidden by default (UX feedback: felt
             redundant between the custom keyboard and the Android keyboard).
             Toggleable via Settings → General → Show bottom nav bar. -->
        <LinearLayout
            android:id="@+id/bottom_action_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_bar_height"
            android:orientation="horizontal"
            android:background="?attr/colorSurface"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_sm"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_keyboard"
                style="@style/Widget.TabSSH.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_sm"
                android:text="@string/tab_terminal_action_keyboard"
                android:drawableTop="@drawable/ic_keyboard" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_snippets"
                style="@style/Widget.TabSSH.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_sm"
                android:text="@string/tab_terminal_action_snippets"
                android:drawableTop="@drawable/ic_code" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_files"
                style="@style/Widget.TabSSH.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_sm"
                android:text="@string/open_files"
                android:drawableTop="@drawable/ic_folder" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_paste"
                style="@style/Widget.TabSSH.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_sm"
                android:text="@string/paste"
                android:drawableTop="@drawable/ic_paste" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_menu"
                style="@style/Widget.TabSSH.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tab_terminal_action_menu"
                android:drawableTop="@drawable/ic_menu" />

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
