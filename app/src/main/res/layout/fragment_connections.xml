<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Outer Hosts toolbar — no menu of its own; sort/bulk-edit live
             on the SSH sub-tab's own toolbar. -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_hosts"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:elevation="@dimen/card_elevation"
            style="@style/Widget.TabSSH.Toolbar.Section" />

        <!-- Unified search — queries SSH + VNC + Telnet hosts and active
             sessions together, regardless of which sub-tab is showing. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_md"
            app:cardElevation="@dimen/elevation_low"
            app:cardCornerRadius="@dimen/card_corner_radius_small">

            <androidx.appcompat.widget.SearchView
                android:id="@+id/search_view_hosts"
                android:layout_width="match_parent"
                android:layout_height="@dimen/icon_size_xlarge"
                app:queryHint="@string/fragment_connections_search_hint"
                app:iconifiedByDefault="false"
                android:background="?attr/colorSurface" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout_hosts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabMode="fixed"
            app:tabGravity="fill" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/view_pager_hosts"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Search results overlay — shown instead of the pager while
                 the unified search box has a non-empty query. -->
            <LinearLayout
                android:id="@+id/layout_search_results"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="?attr/colorSurface"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_search_results"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:paddingStart="@dimen/space_md"
                    android:paddingEnd="@dimen/space_md"
                    android:clipToPadding="false"
                    tools:listitem="@layout/item_search_result"
                    tools:itemCount="6" />

                <LinearLayout
                    android:id="@+id/layout_search_empty"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="@dimen/space_xl"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hosts_search_no_results"
                        android:textSize="@dimen/text_size_subtitle"
                        android:gravity="center"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
