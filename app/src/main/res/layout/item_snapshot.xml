<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_xs"
    app:cardElevation="@dimen/elevation_low"
    app:cardCornerRadius="@dimen/card_corner_radius_small">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_12dp">

        <!-- Snapshot Name -->
        <TextView
            android:id="@+id/snapshot_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/item_snapshot_placeholder_name"
            android:textSize="@dimen/text_size_subtitle"
            android:textStyle="bold" />

        <!-- Snapshot Time -->
        <TextView
            android:id="@+id/snapshot_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/item_snapshot_placeholder_created"
            android:textSize="@dimen/text_size_caption"
            android:textColor="?android:textColorSecondary"
            android:layout_marginTop="@dimen/space_xs" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_sm">

            <Button
                android:id="@+id/revert_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/hypervisor_revert_button"
                style="@style/Widget.Material3.Button.TonalButton" />

            <Button
                android:id="@+id/delete_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/delete"
                android:layout_marginStart="@dimen/space_sm"
                style="@style/Widget.Material3.Button.OutlinedButton" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
