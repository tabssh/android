<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:padding="@dimen/space_20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Beautiful Warning Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/status_warning_container"
            android:padding="@dimen/space_md"
            android:layout_marginBottom="@dimen/space_20dp"
            android:elevation="@dimen/elevation_low">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dialog_host_key_changed_header_title"
                android:textStyle="bold"
                android:textSize="@dimen/text_size_headline"
                android:textColor="@color/status_warning"
                android:gravity="center"
                android:paddingBottom="@dimen/space_sm" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dialog_host_key_changed_header_subtitle"
                android:textSize="@dimen/text_size_small_body"
                android:textColor="@color/status_warning"
                android:gravity="center"
                android:alpha="0.9" />

        </LinearLayout>

        <!-- Possible Reasons Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md"
            style="?attr/materialCardViewElevatedStyle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_host_key_changed_reasons_title"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_body"
                    android:paddingBottom="@dimen/space_sm" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_host_key_changed_reasons_body"
                    android:textSize="@dimen/text_size_small_body"
                    android:lineSpacingExtra="@dimen/space_xs" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Hostname Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md"
            style="?attr/materialCardViewFilledStyle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_host_key_changed_server_label"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_body"
                    android:paddingBottom="@dimen/space_xs" />

                <TextView
                    android:id="@+id/text_hostname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_subtitle"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    tools:text="example.com:22" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Old Key Information Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12dp"
            style="?attr/materialCardViewOutlinedStyle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md"
                android:background="@color/status_error_container">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_host_key_changed_previous_key_title"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="@color/status_error"
                    android:paddingBottom="@dimen/space_sm" />

                <TextView
                    android:id="@+id/text_old_key_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_small_body"
                    android:paddingBottom="@dimen/space_6dp"
                    android:textColor="@color/status_error"
                    tools:text="🔑 ssh-ed25519" />

                <TextView
                    android:id="@+id/text_old_fingerprint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_overline"
                    android:fontFamily="monospace"
                    android:textIsSelectable="true"
                    android:background="?attr/colorSurface"
                    android:padding="@dimen/space_sm"
                    android:textColor="?android:attr/textColorPrimary"
                    tools:text="SHA256:abc123..." />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- New Key Information Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md"
            style="?attr/materialCardViewOutlinedStyle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md"
                android:background="@color/status_info_container">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_host_key_changed_new_key_title"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="@color/status_info"
                    android:paddingBottom="@dimen/space_sm" />

                <TextView
                    android:id="@+id/text_new_key_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_small_body"
                    android:paddingBottom="@dimen/space_6dp"
                    android:textColor="@color/status_info"
                    tools:text="🔑 ssh-ed25519" />

                <TextView
                    android:id="@+id/text_new_fingerprint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_overline"
                    android:fontFamily="monospace"
                    android:textIsSelectable="true"
                    android:background="?attr/colorSurface"
                    android:padding="@dimen/space_sm"
                    android:textColor="?android:attr/textColorPrimary"
                    tools:text="SHA256:xyz789..." />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Timeline Info Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md"
            style="?attr/materialCardViewFilledStyle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_host_key_changed_timeline_title"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_body"
                    android:paddingBottom="@dimen/space_sm" />

                <TextView
                    android:id="@+id/text_first_seen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_small_body"
                    tools:text="First connected: 2025-01-15 10:30" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Beautiful Security Guidance Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="?attr/materialCardViewElevatedStyle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md"
                android:background="?attr/colorSurface">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_host_key_changed_guidance_title"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_15sp"
                    android:textColor="?attr/colorPrimary"
                    android:paddingBottom="@dimen/space_12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_host_key_changed_accept_new_title"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_small_body"
                    android:textColor="@color/status_success"
                    android:paddingBottom="@dimen/space_xs" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_host_key_changed_accept_new_body"
                    android:textSize="@dimen/text_size_caption"
                    android:paddingBottom="@dimen/space_12dp"
                    android:paddingStart="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_xs" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_host_key_changed_accept_once_title"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_small_body"
                    android:textColor="@color/status_warning"
                    android:paddingBottom="@dimen/space_xs" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_host_key_changed_accept_once_body"
                    android:textSize="@dimen/text_size_caption"
                    android:paddingBottom="@dimen/space_12dp"
                    android:paddingStart="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_xs" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_host_key_changed_reject_title"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_small_body"
                    android:textColor="@color/status_error"
                    android:paddingBottom="@dimen/space_xs" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_host_key_changed_reject_body"
                    android:textSize="@dimen/text_size_caption"
                    android:paddingStart="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_xs" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
