<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_md"
    android:paddingEnd="@dimen/space_md"
    android:paddingTop="@dimen/space_12dp"
    android:paddingBottom="@dimen/space_12dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical">

    <!-- Color indicator -->
    <View
        android:id="@+id/view_color_indicator"
        android:layout_width="@dimen/scrollbar_width"
        android:layout_height="match_parent"
        android:layout_marginEnd="@dimen/space_12dp"
        android:background="@color/primary_500" />

    <!-- Group info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_group_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_subtitle"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            tools:text="Production Servers" />

        <TextView
            android:id="@+id/text_connection_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_caption"
            android:textColor="?android:attr/textColorSecondary"
            tools:text="5 connection(s)" />

    </LinearLayout>

    <!-- Expand/collapse icon -->
    <ImageView
        android:id="@+id/icon_expand"
        android:layout_width="@dimen/icon_size_medium"
        android:layout_height="@dimen/icon_size_medium"
        android:src="@android:drawable/arrow_down_float"
        android:contentDescription="@string/item_group_expand_collapse_content_description" />

</LinearLayout>
