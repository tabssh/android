<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Why credentials exist: on-device digest checks by the update checker -->
    <TextView
        android:id="@+id/text_registry_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_sm"
        android:text="@string/container_registry_description"
        android:textSize="@dimen/text_size_body"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- Populated with credential rows; hidden when the store is empty -->
    <ListView
        android:id="@+id/list_credentials"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_sm"
        android:paddingEnd="@dimen/space_sm"
        android:divider="@null"
        android:visibility="gone" />

    <!-- Shown instead of the list when no credentials are stored -->
    <TextView
        android:id="@+id/text_registry_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg"
        android:paddingTop="@dimen/space_sm"
        android:text="@string/container_registry_empty"
        android:textSize="@dimen/text_size_body"
        android:textColor="?attr/colorOnSurface"
        android:visibility="gone" />
</LinearLayout>
