<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_sm"
    app:cardElevation="2dp"
    app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <TextView
            android:id="@+id/text_key_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/identity_key_name_title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_xs">

            <TextView
                android:id="@+id/text_key_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/item_ssh_key_type_placeholder"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:background="?attr/colorPrimaryContainer"
                android:paddingStart="@dimen/space_sm"
                android:paddingEnd="@dimen/space_sm"
                android:paddingTop="@dimen/space_2dp"
                android:paddingBottom="@dimen/space_2dp"
                android:layout_marginEnd="@dimen/space_sm" />

            <TextView
                android:id="@+id/text_key_fingerprint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/item_ssh_key_fingerprint_placeholder"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:textColor="?android:attr/textColorTertiary"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
