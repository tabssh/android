<?xml version="1.0" encoding="utf-8"?>
<!--
  One inventory count on the container host dashboard. The row is a single
  TalkBack node: the icon and both labels are skipped and the row's own
  contentDescription reads as "Containers: 7".
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/min_touch_target"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:focusable="true">

    <ImageView
        android:id="@+id/image_count_icon"
        android:layout_width="@dimen/icon_size_medium"
        android:layout_height="@dimen/icon_size_medium"
        android:layout_marginEnd="@dimen/space_sm"
        android:importantForAccessibility="no"
        app:tint="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/text_count_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/text_count_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:gravity="end"
        android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        android:textColor="?attr/colorOnSurface" />

</LinearLayout>
