<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_xxl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical|end"
                android:paddingStart="@dimen/space_md"
                android:paddingEnd="@dimen/space_sm"
                android:paddingTop="@dimen/space_md"
                android:paddingBottom="@dimen/space_sm">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_ssh_key"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="@dimen/icon_size_40dp"
                    android:layout_height="@dimen/icon_size_40dp"
                    android:contentDescription="@string/identity_ssh_keys_add_content_description"
                    app:icon="@android:drawable/ic_input_add" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_ssh_keys"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="@dimen/space_300dp"
                android:nestedScrollingEnabled="true"
                android:clipToPadding="false"
                android:paddingStart="@dimen/space_sm"
                android:paddingEnd="@dimen/space_sm"
                android:paddingTop="@dimen/space_xs"
                android:paddingBottom="@dimen/space_xs" />

            <TextView
                android:id="@+id/text_ssh_keys_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/identity_ssh_keys_empty_message"
                android:textSize="@dimen/text_size_small_body"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:gravity="center"
                android:paddingTop="@dimen/space_md"
                android:paddingBottom="@dimen/space_xs"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_ssh_keys_empty_cta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="@dimen/space_md"
                android:text="@string/identity_add_ssh_key_title"
                style="@style/Widget.Material3.Button.TonalButton"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
