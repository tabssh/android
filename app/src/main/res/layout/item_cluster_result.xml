<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm"
    app:cardElevation="@dimen/elevation_low"
    app:cardCornerRadius="@dimen/card_corner_radius_small">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/result_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="@dimen/text_size_subtitle"
                android:textStyle="bold"
                android:text="@string/item_cluster_result_placeholder_name" />

            <TextView
                android:id="@+id/result_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold"
                android:text="@string/cluster_status_success" />

            <TextView
                android:id="@+id/result_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_caption"
                android:textColor="?android:attr/textColorSecondary"
                android:paddingStart="@dimen/space_sm"
                android:paddingEnd="@dimen/space_none"
                android:text="@string/item_cluster_result_placeholder_duration" />

            <ImageButton
                android:id="@+id/button_copy_output"
                android:layout_width="@dimen/min_touch_target"
                android:layout_height="@dimen/min_touch_target"
                android:layout_marginStart="@dimen/space_sm"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cluster_result_copy_output_desc"
                android:src="@drawable/ic_copy"
                android:tooltipText="@string/cluster_result_copy_output_tooltip"
                app:tint="?android:attr/textColorSecondary" />

            <ImageButton
                android:id="@+id/button_toggle_output"
                android:layout_width="@dimen/min_touch_target"
                android:layout_height="@dimen/min_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cluster_result_toggle_output_desc"
                android:src="@drawable/ic_expand_more"
                android:tooltipText="@string/cluster_result_toggle_output_tooltip"
                app:tint="?android:attr/textColorSecondary" />

        </LinearLayout>

        <TextView
            android:id="@+id/result_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:textSize="@dimen/text_size_caption"
            android:fontFamily="monospace"
            android:background="?attr/colorSurface"
            android:padding="@dimen/space_sm"
            android:maxLines="10"
            android:scrollbars="vertical"
            android:visibility="gone"
            android:text="@string/item_cluster_result_placeholder_output" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
