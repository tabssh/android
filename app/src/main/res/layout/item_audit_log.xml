<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_xs"
    app:cardElevation="2dp"
    app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_log_timestamp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/audit_log_item_timestamp_placeholder"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />

            <TextView
                android:id="@+id/text_log_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/audit_log_item_status_placeholder"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="@dimen/space_sm"
                android:paddingEnd="@dimen/space_none" />

        </LinearLayout>

        <TextView
            android:id="@+id/text_log_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/audit_log_item_action_placeholder"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginTop="@dimen/space_xs" />

        <TextView
            android:id="@+id/text_log_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/audit_log_item_details_placeholder"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="@dimen/space_xs" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
