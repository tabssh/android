<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/space_md">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_config_select_connection_title"
        android:textSize="@dimen/text_size_headline"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:gravity="center"
        android:paddingBottom="@dimen/space_md" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_config_select_connection_subtitle"
        android:textSize="@dimen/text_size_body"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:gravity="center"
        android:paddingBottom="@dimen/space_md" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_connections"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

    <!-- Empty state — shown when the user has no saved connections to pick from -->
    <LinearLayout
        android:id="@+id/layout_empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/space_xl"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_config_empty_icon"
            android:textSize="@dimen/text_size_64sp"
            android:importantForAccessibility="no"
            android:layout_marginBottom="@dimen/space_md" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_connections_title"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
            android:layout_marginBottom="@dimen/space_sm" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_config_empty_message"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center"
            android:layout_marginBottom="@dimen/space_lg" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_add_connection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_connection"
            style="@style/Widget.Material3.Button.TonalButton" />

    </LinearLayout>

    <Button
        android:id="@+id/button_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/cancel"
        style="@style/Widget.Material3.Button.OutlinedButton" />

</LinearLayout>
