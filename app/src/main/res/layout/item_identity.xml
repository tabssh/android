<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_sm"
    app:cardElevation="@dimen/elevation_low"
    app:cardCornerRadius="@dimen/card_corner_radius_small">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/identity_edit_name_hint"
                android:textSize="@dimen/text_size_subtitle"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_edit"
                android:layout_width="@dimen/min_touch_target"
                android:layout_height="@dimen/min_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_edit"
                android:contentDescription="@string/edit" />

            <ImageButton
                android:id="@+id/btn_delete"
                android:layout_width="@dimen/min_touch_target"
                android:layout_height="@dimen/min_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                android:contentDescription="@string/delete" />

        </LinearLayout>

        <TextView
            android:id="@+id/text_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/item_identity_username_placeholder"
            android:textSize="@dimen/text_size_body"
            android:layout_marginTop="@dimen/space_xs" />

        <TextView
            android:id="@+id/text_auth_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connection_edit_ssh_key_hint"
            android:textSize="@dimen/text_size_caption"
            android:textColor="@color/primary_600"
            android:layout_marginTop="@dimen/space_xs" />

        <TextView
            android:id="@+id/text_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vps_host_edit_hint_description"
            android:textSize="@dimen/text_size_caption"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="@dimen/space_xs" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
