<?xml version="1.0" encoding="utf-8"?>
<!--
  Compact toolbar shown in VNC/graphical console mode in place of
  MultiRowKeyboardView.  Lives inside console_content so it pans with
  the rest of the UI when the soft keyboard opens.

  Buttons (left → right):
    ⌨  keyboard toggle
    ──────────────────
    Ctrl  Alt  Win   (sticky one-shot modifiers; highlighted when armed)
    ──────────────────
    Esc  Tab  F…     (immediate key sends / F-key picker)
    ──────────────────
    ←  ↑  ↓  →       (arrow keys)
    ──────────────────
    ⋮                (overflow: Ctrl+Alt+Del, send text, copy screen, zoom, disconnect)
-->
<HorizontalScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vnc_toolbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none"
    android:fadeScrollbars="true"
    android:background="@color/vnc_toolbar_scrim">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_6dp"
        android:paddingEnd="@dimen/space_6dp"
        android:paddingTop="@dimen/space_xs"
        android:paddingBottom="@dimen/space_xs">

        <!-- Keyboard toggle -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/vnc_btn_keyboard"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_keyboard"
            android:contentDescription="@string/vnc_toolbar_toggle_keyboard_description"
            android:layout_marginEnd="@dimen/space_2dp" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="@color/vnc_toolbar_divider"
            android:layout_marginStart="@dimen/space_2dp"
            android:layout_marginEnd="@dimen/space_xs" />

        <!-- Sticky modifier: Ctrl -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/vnc_btn_ctrl"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vnc_toolbar_key_ctrl"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/space_10dp"
            android:paddingEnd="@dimen/space_10dp"
            android:paddingTop="@dimen/space_6dp"
            android:paddingBottom="@dimen/space_6dp"
            android:checkable="true"
            android:layout_marginEnd="@dimen/space_2dp" />

        <!-- Sticky modifier: Alt -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/vnc_btn_alt"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vnc_toolbar_key_alt"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/space_10dp"
            android:paddingEnd="@dimen/space_10dp"
            android:paddingTop="@dimen/space_6dp"
            android:paddingBottom="@dimen/space_6dp"
            android:checkable="true"
            android:layout_marginEnd="@dimen/space_2dp" />

        <!-- Sticky modifier: Win/Super -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/vnc_btn_win"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vnc_toolbar_key_win"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/space_10dp"
            android:paddingEnd="@dimen/space_10dp"
            android:paddingTop="@dimen/space_6dp"
            android:paddingBottom="@dimen/space_6dp"
            android:checkable="true"
            android:layout_marginEnd="@dimen/space_2dp" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="@color/vnc_toolbar_divider"
            android:layout_marginStart="@dimen/space_2dp"
            android:layout_marginEnd="@dimen/space_xs" />

        <!-- Escape -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/vnc_btn_esc"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vnc_toolbar_key_esc"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/space_10dp"
            android:paddingEnd="@dimen/space_10dp"
            android:paddingTop="@dimen/space_6dp"
            android:paddingBottom="@dimen/space_6dp"
            android:layout_marginEnd="@dimen/space_2dp" />

        <!-- Tab -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/vnc_btn_tab"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vnc_toolbar_key_tab"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/space_10dp"
            android:paddingEnd="@dimen/space_10dp"
            android:paddingTop="@dimen/space_6dp"
            android:paddingBottom="@dimen/space_6dp"
            android:layout_marginEnd="@dimen/space_2dp" />

        <!-- F-key picker -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/vnc_btn_fkeys"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vnc_toolbar_fkeys_button"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/space_10dp"
            android:paddingEnd="@dimen/space_10dp"
            android:paddingTop="@dimen/space_6dp"
            android:paddingBottom="@dimen/space_6dp"
            android:layout_marginEnd="@dimen/space_2dp" />

        <!-- Arrow keys -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/vnc_btn_arrow_left"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_arrow_left"
            android:contentDescription="@string/vnc_toolbar_arrow_left_description"
            android:layout_marginEnd="@dimen/space_2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vnc_btn_arrow_up"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_arrow_up"
            android:contentDescription="@string/vnc_toolbar_arrow_up_description"
            android:layout_marginEnd="@dimen/space_2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vnc_btn_arrow_down"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_arrow_down"
            android:contentDescription="@string/vnc_toolbar_arrow_down_description"
            android:layout_marginEnd="@dimen/space_2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vnc_btn_arrow_right"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_arrow_right"
            android:contentDescription="@string/vnc_toolbar_arrow_right_description"
            android:layout_marginEnd="@dimen/space_2dp" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="@color/vnc_toolbar_divider"
            android:layout_marginStart="@dimen/space_2dp"
            android:layout_marginEnd="@dimen/space_xs" />

        <!-- Overflow / more -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/vnc_btn_more"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_icon_overflow_menu"
            android:textSize="16sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/space_10dp"
            android:paddingEnd="@dimen/space_10dp"
            android:paddingTop="@dimen/space_6dp"
            android:paddingBottom="@dimen/space_6dp" />

    </LinearLayout>

</HorizontalScrollView>
