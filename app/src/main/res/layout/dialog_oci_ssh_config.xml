<?xml version="1.0" encoding="utf-8"?>
<!--
  SSH configuration dialog for OCI Compute instances.
  Shown every time the user taps "SSH Connect" on an instance row;
  values are pre-filled from the saved ConnectionProfile (if any) and
  persisted on Connect so subsequent taps remember the settings.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/space_sm"
    android:paddingEnd="@dimen/space_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_sm">

        <!-- Instance label -->
        <TextView
            android:id="@+id/oci_ssh_instance_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Username -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm"
            android:hint="@string/username_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/oci_ssh_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textNoSuggestions"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Port -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm"
            android:hint="@string/route_port_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/oci_ssh_port"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:singleLine="true"
                android:text="@string/common_default_ssh_port" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Auth method label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:layout_marginBottom="@dimen/space_xs"
            android:text="@string/route_auth_type_hint"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <!-- Auth method spinner -->
        <Spinner
            android:id="@+id/oci_ssh_auth_method"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm" />

        <!-- Key picker (shown only when auth = PUBLIC_KEY) -->
        <TextView
            android:id="@+id/oci_ssh_key_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:layout_marginBottom="@dimen/space_xs"
            android:text="@string/oci_ssh_identity_key_label"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/oci_ssh_key_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm"
            android:visibility="gone" />

        <!-- No-keys hint -->
        <TextView
            android:id="@+id/oci_ssh_no_keys_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm"
            android:text="@string/oci_ssh_no_keys_hint"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorError"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
