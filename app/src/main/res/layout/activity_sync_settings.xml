<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/app_bar"
        layout="@layout/include_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <!-- ── STATUS CARD ───────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12dp"
                app:cardElevation="@dimen/elevation_none"
                app:strokeWidth="@dimen/card_stroke_width"
                app:strokeColor="?attr/colorOutlineVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/text_status_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_display"
                            android:text="@string/common_icon_settings"
                            android:layout_marginEnd="@dimen/space_12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/text_status_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sync_settings_status_not_configured"
                                android:textAppearance="?attr/textAppearanceTitleMedium" />

                            <TextView
                                android:id="@+id/text_status_subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sync_settings_status_complete_setup"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?android:attr/textColorSecondary" />

                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_sync_now"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sync_settings_sync_now"
                            android:visibility="gone"
                            style="@style/Widget.Material3.Button.TonalButton"
                            app:icon="@android:drawable/ic_menu_rotate" />

                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progress_sync"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:visibility="gone"
                        style="@style/Widget.Material3.LinearProgressIndicator" />

                    <TextView
                        android:id="@+id/text_last_sync"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:visibility="gone"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="?android:attr/textColorSecondary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── SETUP SECTION ─────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sync_settings_section_setup"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="@dimen/space_xs"
                android:layout_marginStart="@dimen/space_xs" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12dp"
                app:cardElevation="@dimen/elevation_none"
                app:strokeWidth="@dimen/card_stroke_width"
                app:strokeColor="?attr/colorOutlineVariant">

                <!-- Location row -->
                <LinearLayout
                    android:id="@+id/row_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="@dimen/space_md">

                        <TextView
                            android:id="@+id/icon_location"
                            android:layout_width="@dimen/icon_size_badge"
                            android:layout_height="@dimen/icon_size_badge"
                            android:text="@string/group_mgmt_empty_icon"
                            android:textSize="@dimen/text_size_title"
                            android:gravity="center"
                            android:layout_marginEnd="@dimen/space_md" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sync_settings_location_title"
                                android:textAppearance="?attr/textAppearanceBodyLarge" />

                            <TextView
                                android:id="@+id/text_location_summary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sync_settings_location_summary"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?android:attr/textColorSecondary" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/badge_location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/common_icon_check"
                            android:textColor="@android:color/holo_green_dark"
                            android:textSize="@dimen/text_size_title"
                            android:visibility="gone" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_height"
                        android:layout_marginStart="@dimen/space_60dp"
                        android:background="?attr/colorOutlineVariant" />

                    <!-- Password row -->
                    <LinearLayout
                        android:id="@+id/row_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="@dimen/space_md">

                        <TextView
                            android:layout_width="@dimen/icon_size_badge"
                            android:layout_height="@dimen/icon_size_badge"
                            android:text="@string/common_icon_key"
                            android:textSize="@dimen/text_size_title"
                            android:gravity="center"
                            android:layout_marginEnd="@dimen/space_md" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sync_settings_password_title"
                                android:textAppearance="?attr/textAppearanceBodyLarge" />

                            <TextView
                                android:id="@+id/text_password_summary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sync_settings_password_summary"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?android:attr/textColorSecondary" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/badge_password"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/common_icon_check"
                            android:textColor="@android:color/holo_green_dark"
                            android:textSize="@dimen/text_size_title"
                            android:visibility="gone" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── ENABLE TOGGLE ─────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_20dp"
                app:cardElevation="@dimen/elevation_none"
                app:strokeWidth="@dimen/card_stroke_width"
                app:strokeColor="?attr/colorOutlineVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/space_md">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sync_settings_enable_sync"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                        <TextView
                            android:id="@+id/text_toggle_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sync_settings_enable_sync_hint"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?android:attr/textColorSecondary" />

                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_sync_enabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:enabled="false" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── OPTIONS (hidden until enabled) ───────────────── -->
            <LinearLayout
                android:id="@+id/section_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sync_settings_section_options"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="@dimen/space_xs"
                    android:layout_marginStart="@dimen/space_xs" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_12dp"
                    app:cardElevation="@dimen/elevation_none"
                    app:strokeWidth="@dimen/card_stroke_width"
                    app:strokeColor="?attr/colorOutlineVariant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Frequency -->
                        <LinearLayout
                            android:id="@+id/row_frequency"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="@dimen/space_md">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/sync_settings_frequency_title"
                                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                                <TextView
                                    android:id="@+id/text_frequency_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/sync_settings_frequency_hourly"
                                    android:textAppearance="?attr/textAppearanceBodySmall"
                                    android:textColor="?android:attr/textColorSecondary" />

                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/common_icon_chevron_right"
                                android:textSize="@dimen/text_size_headline"
                                android:textColor="?android:attr/textColorSecondary" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/divider_height"
                            android:layout_marginStart="@dimen/space_md"
                            android:background="?attr/colorOutlineVariant" />

                        <!-- WiFi only -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="@dimen/space_md">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/sync_settings_wifi_only_title"
                                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/sync_settings_wifi_only_summary"
                                    android:textAppearance="?attr/textAppearanceBodySmall"
                                    android:textColor="?android:attr/textColorSecondary" />

                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switch_wifi_only"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/divider_height"
                            android:layout_marginStart="@dimen/space_md"
                            android:background="?attr/colorOutlineVariant" />

                        <!-- Sync on change -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="@dimen/space_md">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/sync_settings_sync_on_change_title"
                                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/sync_settings_sync_on_change_summary"
                                    android:textAppearance="?attr/textAppearanceBodySmall"
                                    android:textColor="?android:attr/textColorSecondary" />

                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switch_sync_on_change"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ── WHAT TO SYNC ─────────────────────────────── -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sync_settings_section_what_to_sync"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="@dimen/space_xs"
                    android:layout_marginStart="@dimen/space_xs" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_12dp"
                    app:cardElevation="@dimen/elevation_none"
                    app:strokeWidth="@dimen/card_stroke_width"
                    app:strokeColor="?attr/colorOutlineVariant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <include layout="@layout/item_sync_toggle"
                            android:id="@+id/row_sync_connections" />
                        <View android:layout_width="match_parent" android:layout_height="@dimen/divider_height" android:layout_marginStart="@dimen/space_md" android:background="?attr/colorOutlineVariant" />
                        <include layout="@layout/item_sync_toggle"
                            android:id="@+id/row_sync_identities" />
                        <View android:layout_width="match_parent" android:layout_height="@dimen/divider_height" android:layout_marginStart="@dimen/space_md" android:background="?attr/colorOutlineVariant" />
                        <include layout="@layout/item_sync_toggle"
                            android:id="@+id/row_sync_keys" />
                        <View android:layout_width="match_parent" android:layout_height="@dimen/divider_height" android:layout_marginStart="@dimen/space_md" android:background="?attr/colorOutlineVariant" />
                        <include layout="@layout/item_sync_toggle"
                            android:id="@+id/row_sync_snippets" />
                        <View android:layout_width="match_parent" android:layout_height="@dimen/divider_height" android:layout_marginStart="@dimen/space_md" android:background="?attr/colorOutlineVariant" />
                        <include layout="@layout/item_sync_toggle"
                            android:id="@+id/row_sync_themes" />
                        <View android:layout_width="match_parent" android:layout_height="@dimen/divider_height" android:layout_marginStart="@dimen/space_md" android:background="?attr/colorOutlineVariant" />
                        <include layout="@layout/item_sync_toggle"
                            android:id="@+id/row_sync_host_keys" />
                        <View android:layout_width="match_parent" android:layout_height="@dimen/divider_height" android:layout_marginStart="@dimen/space_md" android:background="?attr/colorOutlineVariant" />
                        <include layout="@layout/item_sync_toggle"
                            android:id="@+id/row_sync_groups" />
                        <View android:layout_width="match_parent" android:layout_height="@dimen/divider_height" android:layout_marginStart="@dimen/space_md" android:background="?attr/colorOutlineVariant" />
                        <include layout="@layout/item_sync_toggle"
                            android:id="@+id/row_sync_workspaces" />
                        <View android:layout_width="match_parent" android:layout_height="@dimen/divider_height" android:layout_marginStart="@dimen/space_md" android:background="?attr/colorOutlineVariant" />
                        <include layout="@layout/item_sync_toggle"
                            android:id="@+id/row_sync_macros" />
                        <View android:layout_width="match_parent" android:layout_height="@dimen/divider_height" android:layout_marginStart="@dimen/space_md" android:background="?attr/colorOutlineVariant" />
                        <include layout="@layout/item_sync_toggle"
                            android:id="@+id/row_sync_monitor_slots" />
                        <View android:layout_width="match_parent" android:layout_height="@dimen/divider_height" android:layout_marginStart="@dimen/space_md" android:background="?attr/colorOutlineVariant" />
                        <include layout="@layout/item_sync_toggle"
                            android:id="@+id/row_sync_hypervisors" />
                        <View android:layout_width="match_parent" android:layout_height="@dimen/divider_height" android:layout_marginStart="@dimen/space_md" android:background="?attr/colorOutlineVariant" />
                        <include layout="@layout/item_sync_toggle"
                            android:id="@+id/row_sync_hypervisor_accounts" />
                        <View android:layout_width="match_parent" android:layout_height="@dimen/divider_height" android:layout_marginStart="@dimen/space_md" android:background="?attr/colorOutlineVariant" />
                        <include layout="@layout/item_sync_toggle"
                            android:id="@+id/row_sync_vnc_hosts" />
                        <View android:layout_width="match_parent" android:layout_height="@dimen/divider_height" android:layout_marginStart="@dimen/space_md" android:background="?attr/colorOutlineVariant" />
                        <include layout="@layout/item_sync_toggle"
                            android:id="@+id/row_sync_vnc_identities" />
                        <View android:layout_width="match_parent" android:layout_height="@dimen/divider_height" android:layout_marginStart="@dimen/space_md" android:background="?attr/colorOutlineVariant" />
                        <include layout="@layout/item_sync_toggle"
                            android:id="@+id/row_sync_cloud_accounts" />
                        <View android:layout_width="match_parent" android:layout_height="@dimen/divider_height" android:layout_marginStart="@dimen/space_md" android:background="?attr/colorOutlineVariant" />
                        <include layout="@layout/item_sync_toggle"
                            android:id="@+id/row_sync_certificates" />
                        <View android:layout_width="match_parent" android:layout_height="@dimen/divider_height" android:layout_marginStart="@dimen/space_md" android:background="?attr/colorOutlineVariant" />
                        <include layout="@layout/item_sync_toggle"
                            android:id="@+id/row_sync_port_forwards" />
                        <View android:layout_width="match_parent" android:layout_height="@dimen/divider_height" android:layout_marginStart="@dimen/space_md" android:background="?attr/colorOutlineVariant" />
                        <include layout="@layout/item_sync_toggle"
                            android:id="@+id/row_sync_network_routes" />
                        <View android:layout_width="match_parent" android:layout_height="@dimen/divider_height" android:layout_marginStart="@dimen/space_md" android:background="?attr/colorOutlineVariant" />
                        <include layout="@layout/item_sync_toggle"
                            android:id="@+id/row_sync_containers" />
                        <View android:layout_width="match_parent" android:layout_height="@dimen/divider_height" android:layout_marginStart="@dimen/space_md" android:background="?attr/colorOutlineVariant" />
                        <include layout="@layout/item_sync_toggle"
                            android:id="@+id/row_sync_pane_groups" />
                        <View android:layout_width="match_parent" android:layout_height="@dimen/divider_height" android:layout_marginStart="@dimen/space_md" android:background="?attr/colorOutlineVariant" />
                        <include layout="@layout/item_sync_toggle"
                            android:id="@+id/row_sync_telnet_hosts" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ── DASHBOARD ─────────────────────────────────── -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sync_settings_section_dashboard"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="@dimen/space_xs"
                    android:layout_marginStart="@dimen/space_xs" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_12dp"
                    app:cardElevation="@dimen/elevation_none"
                    app:strokeWidth="@dimen/card_stroke_width"
                    app:strokeColor="?attr/colorOutlineVariant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <include layout="@layout/item_sync_toggle"
                            android:id="@+id/row_sync_dashboard" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/space_md"
                            android:paddingEnd="@dimen/space_md"
                            android:paddingBottom="@dimen/space_12dp"
                            android:text="@string/sync_settings_dashboard_summary"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ── ADVANCED ──────────────────────────────────── -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sync_settings_section_advanced"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="@dimen/space_xs"
                    android:layout_marginStart="@dimen/space_xs" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_lg"
                    app:cardElevation="@dimen/elevation_none"
                    app:strokeWidth="@dimen/card_stroke_width"
                    app:strokeColor="?attr/colorOutlineVariant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/btn_force_upload"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/space_md"
                            android:text="@string/sync_settings_force_upload"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true" />

                        <View android:layout_width="match_parent" android:layout_height="@dimen/divider_height" android:layout_marginStart="@dimen/space_md" android:background="?attr/colorOutlineVariant" />

                        <TextView
                            android:id="@+id/btn_force_download"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/space_md"
                            android:text="@string/sync_settings_force_download"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true" />

                        <View android:layout_width="match_parent" android:layout_height="@dimen/divider_height" android:layout_marginStart="@dimen/space_md" android:background="?attr/colorOutlineVariant" />

                        <TextView
                            android:id="@+id/btn_view_sync_log"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/space_md"
                            android:text="@string/sync_view_log"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true" />

                        <View android:layout_width="match_parent" android:layout_height="@dimen/divider_height" android:layout_marginStart="@dimen/space_md" android:background="?attr/colorOutlineVariant" />

                        <TextView
                            android:id="@+id/btn_clear_config"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/space_md"
                            android:text="@string/sync_settings_clear_configuration"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="@android:color/holo_red_dark"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
